# Copy this file to ~/.config/zsh/local.env.zsh and fill in real values locally.

export CLAUDE_CODE_USE_FOUNDRY=1
export CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING=1
export ANTHROPIC_FOUNDRY_API_KEY="replace-me"
export ANTHROPIC_FOUNDRY_BASE_URL="https://example.invalid/apim/claude"
export ANTHROPIC_CUSTOM_HEADERS="user-id: replace-me"
export ANTHROPIC_LOG="info"
export NODE_EXTRA_CA_CERTS="$HOME/.claude-certs/full_chain.pem"
